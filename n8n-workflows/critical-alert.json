[{
  "name": "Alerta Crítica Telegram",
  "active": false,
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook: Nuevo Triaje",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "critical-alert",
      "parameters": {
        "httpMethod": "POST",
        "path": "critical-alert",
        "responseMode": "responseNode",
        "responseData": {
          "allEntries": {}
        }
      }
    },
    {
      "id": "filter-urgency",
      "name": "¿Es RED u ORANGE?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.nivel_urgencia_final || $json.nivelUrgenciaFinal }}",
              "rightValue": "RED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-2",
              "leftValue": "={{ $json.nivel_urgencia_final || $json.nivelUrgenciaFinal }}",
              "rightValue": "ORANGE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
      "id": "fetch-medicos",
      "name": "Obtener Médicos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [650, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT nombres, apellidos FROM usuarios WHERE rol = 'medico' AND activo = true;"
      },
      "credentials": {
        "postgres": "triage-postgres"
      }
    },
    {
      "id": "format-message",
      "name": "Formatear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200],
      "parameters": {
        "jsCode": "const paciente = $input.first().json;\nconst medicos = $('Obtener Médicos').all()[0].json;\n\nconst nombre = paciente.paciente_nombre_completo || paciente.pacienteNombreCompleto || 'Paciente';\nconst nivel = paciente.nivel_urgencia_final || paciente.nivelUrgenciaFinal;\nconst motivo = paciente.motivo_consulta || paciente.motivoConsulta || 'N/A';\nconst id = paciente.id || paciente.Id;\nconst timestamp = new Date().toLocaleString('es-CL');\n\nlet medList = medicos.map(m => `- Dr. ${m.nombres} ${m.apellidos}`).join('\\n');\n\nconst mensaje = `🚨 *ALERTA DE TRIAJE* 🚨\n\n🏥 *Paciente:* ${nombre}\n⚠️ *Nivel:* ${nivel === 'RED' ? '🔴 CRÍTICO' : '🟠 URGENTE'}\n📝 *Motivo:* ${motivo}\n🆔 *ID Triaje:* ${id}\n\n📋 *Médicos disponibles:*\n${medList}\n\n⏰ *Timestamp:* ${timestamp}\n📍 *Unidad:* Emergencia`;\n\nreturn [{ json: { chat_id: process.env.TELEGRAM_CHAT_ID, text: mensaje, parse_mode: 'Markdown' } }];"
      }
    },
    {
      "id": "send-telegram",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1050, 200],
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalOptions": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": "triage-bot"
      }
    },
    {
      "id": "log-skip",
      "name": "Log: No crítico",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 200],
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={{ { status: 'alert_sent', timestamp: new Date().toISOString() } }}"
      }
    }
  ],
  "connections": {
    "Webhook: Nuevo Triaje": {
      "main": [
        [
          {
            "node": "¿Es RED u ORANGE?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Es RED u ORANGE?": {
      "main": [
        [
          {
            "node": "Obtener Médicos",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log: No crítico",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Médicos": {
      "main": [
        [
          {
            "node": "Formatear Mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Mensaje": {
      "main": [
        [
          {
            "node": "Enviar Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Telegram": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    {
      "name": "critical",
      "id": "tag-critical"
    },
    {
      "name": "telegram",
      "id": "tag-telegram"
    }
  ]
}]
