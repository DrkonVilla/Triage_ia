# Database
DATABASE_URL=postgresql+asyncpg://triaje_user:triaje_pass@postgres:5432/triaje_db
POSTGRES_USER=triaje_user
POSTGRES_PASSWORD=triaje_pass
POSTGRES_DB=triaje_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# n8n Webhooks
N8N_WEBHOOK_CRITICAL_ALERT=http://n8n:5678/webhook/critical-alert
N8N_WEBHOOK_HCE_SYNC=http://n8n:5678/webhook/hce-sync

# Mock HCE
MOCK_HCE_URL=http://mock-hce:8080/api/fhir

# Email (para reportes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@hospital.com
SMTP_PASSWORD=your-smtp-password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-admin-chat-id